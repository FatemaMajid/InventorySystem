using System.Globalization;
using System.Security.Cryptography;
using InventorySystem.Application.Common.Exceptions;
using InventorySystem.Application.Common.Interfaces;
using InventorySystem.Application.Common.Localization;
using InventorySystem.Application.DTOs.FinancialAnalysis.FinancialUpload;
using InventorySystem.Application.Features.FinancialAnalysis.Common.Excel;
using InventorySystem.Domain.FinancialAnalysis.Entities;
using InventorySystem.Domain.FinancialAnalysis.Enums;
using MediatR;
using Microsoft.EntityFrameworkCore;
using Microsoft.Extensions.Logging;

namespace InventorySystem.Application.Features.FinancialAnalysis.FinancialUploads.Commands.UploadFinancialFile;

public class UploadFinancialFileCommandHandler : IRequestHandler<UploadFinancialFileCommand, FinancialUploadDto> {
    private readonly IApplicationDbContext _context;
    private readonly ICurrentUserService _currentUser;
    private readonly IAuditLogService _auditLogService;
    private readonly IFinancialFileStorageService _fileStorage;
    private readonly FinancialExcelParser _excelParser;
    private readonly ILogger<UploadFinancialFileCommandHandler> _logger;

    public UploadFinancialFileCommandHandler(IApplicationDbContext context, ICurrentUserService currentUser,
        IAuditLogService auditLogService, IFinancialFileStorageService fileStorage,
        FinancialExcelParser excelParser, ILogger<UploadFinancialFileCommandHandler> logger){
        _context = context;
        _currentUser = currentUser;
        _auditLogService = auditLogService;
        _fileStorage = fileStorage;
        _excelParser = excelParser;
        _logger = logger;
    }

    public async Task<FinancialUploadDto> Handle(UploadFinancialFileCommand request, CancellationToken cancellationToken){
        var period = await _context.FinancialPeriods.FirstOrDefaultAsync(
            x => x.Id == request.FinancialPeriodId && !x.IsDeleted, cancellationToken);
        if (period is null){
            throw new KeyNotFoundException(LocalizationKeys.FinancialPeriod.NotFound);
        }
        if (period.Status == FinancialPeriodStatus.Approved){
            throw new InvalidOperationException(LocalizationKeys.FinancialPeriod.AlreadyApproved);
        }

        string? branchCode = null;
        string? branchNameArabic = null;
        if (request.Scope == FinancialFileScope.SingleBranch){
            var branch = await _context.Branches.AsNoTracking().FirstOrDefaultAsync(
                x => x.Id == request.BranchId && !x.IsDeleted && x.IsActive &&
                     x.BranchCode != "0" && x.BranchCode != "001" && x.BranchCode != "002", cancellationToken);
            if (branch is null){
                throw new InvalidOperationException(LocalizationKeys.FinancialAnalysis.BranchNotFound);
            }
            branchCode = branch.BranchCode;
            branchNameArabic = branch.BranchNameArabic;
        }

        var fileHash = Convert.ToHexString(SHA256.HashData(request.Content));
        var activeUpload = await _context.FinancialUploads.FirstOrDefaultAsync(
            x => x.FinancialPeriodId == request.FinancialPeriodId &&
                 x.FileType == request.FileType && x.BranchId == request.BranchId &&
                 x.Gender == request.Gender && x.IsActive && !x.IsDeleted, cancellationToken);
        if (activeUpload is not null && activeUpload.FileHash == fileHash){
            throw new DuplicateFinancialUploadException();
        }

        var lastVersion = await _context.FinancialUploads
            .Where(x => x.FinancialPeriodId == request.FinancialPeriodId &&
                        x.FileType == request.FileType && x.BranchId == request.BranchId &&
                        x.Gender == request.Gender && !x.IsDeleted)
            .MaxAsync(x => (int?)x.Version, cancellationToken) ?? 0;
        var extension = Path.GetExtension(request.OriginalFileName).ToLowerInvariant();
        var storedFileName = $"{Guid.NewGuid():N}{extension}";
        var storagePath = await _fileStorage.SaveAsync(request.Content, storedFileName,
            period.StartDate.Year, period.StartDate.Month, cancellationToken);
        var now = DateTime.UtcNow;
        var upload = new FinancialUpload {
            FinancialPeriodId = request.FinancialPeriodId,
            FileType = request.FileType,
            BranchId = request.BranchId,
            Gender = request.Gender,
            Scope = request.Scope,
            OriginalFileName = Path.GetFileName(request.OriginalFileName),
            StoredFileName = storedFileName,
            StoragePath = storagePath,
            FileHash = fileHash,
            FileSize = request.Content.LongLength,
            Status = FinancialUploadStatus.Validating,
            Version = lastVersion + 1,
            IsActive = false,
            UploadedAt = now,
            UploadedBy = _currentUser.Username,
            CreatedAt = now,
            CreatedBy = _currentUser.Username
        };
        _context.FinancialUploads.Add(upload);
        if (period.Status == FinancialPeriodStatus.Draft){
            period.Status = FinancialPeriodStatus.Uploading;
            period.UpdatedAt = DateTime.UtcNow;
            period.UpdatedBy = _currentUser.Username;
        }

        try {
            await _context.SaveChangesAsync(cancellationToken);
        }
        catch {
            try {
                await _fileStorage.DeleteAsync(storagePath, CancellationToken.None);
            }
            catch (Exception cleanupEx){
                _logger.LogError(cleanupEx, "Failed to delete financial upload after database save failure. Path: {StoragePath}", storagePath);
            }
            throw;
        }

        FinancialExcelParseResult? parseResult;
        try {
            parseResult = await _excelParser.ParseAsync(upload, request.Content, cancellationToken);
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested){
            _logger.LogInformation("Financial upload parsing canceled. UploadId: {UploadId}, PeriodId: {PeriodId}", upload.Id, period.Id);
            throw;
        }
        catch (Exception ex){
            if (ex is InvalidDataException && ex.InnerException is null){
                _logger.LogWarning(ex, "Financial upload validation failed. UploadId: {UploadId}, PeriodId: {PeriodId}", upload.Id, period.Id);
            }
            else {
                _logger.LogError(ex, "Financial upload parsing failed. UploadId: {UploadId}, PeriodId: {PeriodId}", upload.Id, period.Id);
            }
            await MarkUploadInvalidAsync(upload, period.Id, ex, CancellationToken.None);
            parseResult = null;
        }

        if (parseResult is not null){
            bool commitAttempted = false;
            bool rollbackSucceeded = false;
            try {
                await using var transaction = await _context.Database.BeginTransactionAsync(cancellationToken);
                try {
                    if (parseResult.AccountRows.Count > 0){
                        _context.FinancialAccountRows.AddRange(parseResult.AccountRows);
                    }
                    if (parseResult.TransferRecords.Count > 0){
                        _context.TransferRecords.AddRange(parseResult.TransferRecords);
                    }
                    if (parseResult.SettlementRows.Count > 0){
                        _context.SettlementRows.AddRange(parseResult.SettlementRows);
                    }
                    if (parseResult.SettlementSummary is not null){
                        _context.SettlementSummaries.Add(parseResult.SettlementSummary);
                    }
                    if (activeUpload is not null){
                        activeUpload.IsActive = false;
                        activeUpload.UpdatedAt = DateTime.UtcNow;
                        activeUpload.UpdatedBy = _currentUser.Username;
                    }
                    upload.Status = FinancialUploadStatus.Valid;
                    upload.IsActive = true;
                    upload.ValidatedAt = DateTime.UtcNow;
                    upload.ValidationMessage = $"Valid. Parsed rows: {parseResult.ParsedRowCount}.";
                    upload.UpdatedAt = DateTime.UtcNow;
                    upload.UpdatedBy = _currentUser.Username;
                    await _context.SaveChangesAsync(cancellationToken);
                    await UpdatePeriodStatusAsync(period, cancellationToken);
                    await _auditLogService.LogAsync(
                        action: "Upload",
                        entity: "FinancialUpload",
                        entityId: upload.Id.ToString(),
                        details: $"PeriodId: {period.Id}, " +
                                 $"FileType: {upload.FileType}, " +
                                 $"BranchId: {upload.BranchId}, " +
                                 $"Gender: {upload.Gender}, " +
                                 $"Version: {upload.Version}, " +
                                 $"Status: Valid, " +
                                 $"Rows: {parseResult.ParsedRowCount}",
                        cancellationToken: cancellationToken);
                    commitAttempted = true;
                    await transaction.CommitAsync(cancellationToken);
                }
                catch {
                    if (!commitAttempted){
                        try {
                            await transaction.RollbackAsync(CancellationToken.None);
                            rollbackSucceeded = true;
                        }
                        catch (Exception rollbackEx){
                            _logger.LogError(rollbackEx, "Financial upload rollback failed. UploadId: {UploadId}, PeriodId: {PeriodId}", upload.Id, period.Id);
                        }
                    }
                    throw;
                }
            }
            catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested){
                _logger.LogInformation("Financial upload transaction canceled. UploadId: {UploadId}, PeriodId: {PeriodId}", upload.Id, period.Id);
                throw;
            }
            catch (Exception ex){
                if (commitAttempted || !rollbackSucceeded){
                    _logger.LogError(ex, "Financial upload transaction outcome is uncertain. UploadId: {UploadId}, PeriodId: {PeriodId}", upload.Id, period.Id);
                    throw;
                }
                _logger.LogError(ex, "Financial upload transaction failed. UploadId: {UploadId}, PeriodId: {PeriodId}", upload.Id, period.Id);
                var uploadId = upload.Id;
                if (_context is DbContext dbContext){
                    dbContext.ChangeTracker.Clear();
                }
                upload = await _context.FinancialUploads.FirstAsync(x => x.Id == uploadId, CancellationToken.None);
                await MarkUploadInvalidAsync(upload, period.Id, ex, CancellationToken.None);
            }
        }

        return new FinancialUploadDto {
            Id = upload.Id,
            FinancialPeriodId = upload.FinancialPeriodId,
            FileType = upload.FileType,
            BranchId = upload.BranchId,
            BranchCode = branchCode,
            BranchNameArabic = branchNameArabic,
            Gender = upload.Gender,
            Scope = upload.Scope,
            OriginalFileName = upload.OriginalFileName,
            FileSize = upload.FileSize,
            Status = upload.Status,
            Version = upload.Version,
            IsActive = upload.IsActive,
            UploadedAt = upload.UploadedAt,
            UploadedBy = upload.UploadedBy,
            ValidationMessage = ResolveValidationMessage(upload.ValidationMessage)
        };
    }

    private async Task MarkUploadInvalidAsync(FinancialUpload upload, int financialPeriodId,
        Exception exception, CancellationToken cancellationToken){
        upload.Status = FinancialUploadStatus.Invalid;
        upload.IsActive = false;
        upload.ValidatedAt = DateTime.UtcNow;
        upload.ValidationMessage = exception is InvalidDataException && exception.InnerException is null
            ? Truncate(exception.Message, 2000)
            : LocalizationKeys.Excel.ImportFailed;
        upload.UpdatedAt = DateTime.UtcNow;
        upload.UpdatedBy = _currentUser.Username;

        await using var transaction = await _context.Database.BeginTransactionAsync(cancellationToken);
        await _context.SaveChangesAsync(cancellationToken);
        await _auditLogService.LogAsync(
            action: "Upload",
            entity: "FinancialUpload",
            entityId: upload.Id.ToString(),
            details: $"PeriodId: {financialPeriodId}, " +
                     $"FileType: {upload.FileType}, " +
                     $"BranchId: {upload.BranchId}, " +
                     $"Gender: {upload.Gender}, " +
                     $"Version: {upload.Version}, " +
                     $"Status: Invalid, " +
                     $"Error: {upload.ValidationMessage}",
            cancellationToken: cancellationToken);
        await transaction.CommitAsync(cancellationToken);
    }

    private static string? ResolveValidationMessage(string? message){
        if (message == LocalizationKeys.Excel.ImportFailed){
            return LocalizationService.Get(message, CultureInfo.CurrentUICulture.TwoLetterISOLanguageName);
        }
        return message;
    }

    private async Task UpdatePeriodStatusAsync(FinancialPeriod period, CancellationToken cancellationToken){
        var activeBranchCount = await _context.Branches.CountAsync(
            x => !x.IsDeleted && x.IsActive && x.BranchCode != "0" &&
                 x.BranchCode != "001" && x.BranchCode != "002", cancellationToken);
        var expectedFiles = 2 + (activeBranchCount * 2) + activeBranchCount + activeBranchCount;
        var validUploads = await _context.FinancialUploads.CountAsync(
            x => x.FinancialPeriodId == period.Id && x.IsActive && !x.IsDeleted &&
                 x.Status == FinancialUploadStatus.Valid, cancellationToken);
        if (validUploads == expectedFiles){
            period.Status = FinancialPeriodStatus.Ready;
        }
        else if (period.Status != FinancialPeriodStatus.Approved){
            period.Status = FinancialPeriodStatus.Uploading;
        }
        period.UpdatedAt = DateTime.UtcNow;
        period.UpdatedBy = _currentUser.Username;
        await _context.SaveChangesAsync(cancellationToken);
    }

    private static string Truncate(string value, int maxLength){
        if (string.IsNullOrEmpty(value)){
            return value;
        }
        return value.Length <= maxLength ? value : value[..maxLength];
    }
}
