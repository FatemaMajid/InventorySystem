    private static readonly HashSet<string> IgnoredFields =
        new(StringComparer.OrdinalIgnoreCase)
        {
            "financialPeriodId",
            "startDate",
            "endDate",
            "status",
            "activeBranches",
            "branchId",
            "hasFile",
            "uploadId",
            "gender",
            "branches"
        };

    public Task<byte[]> ExportAsync(
        FinancialAnalysisDashboardDto dashboard,
        string language,
        CancellationToken cancellationToken)
    {
        cancellationToken.ThrowIfCancellationRequested();

        language =
            FinancialAnalysisLocalization.NormalizeLanguage(language);

        using var workbook = new XLWorkbook();

        CreateOverviewSheet(workbook,dashboard,language);

        foreach(var sectionName in dashboard.SelectedSections)
        {
            if(!dashboard.Sections.TryGetValue(sectionName,out var section) ||
               section is null)
            {
                continue;
            }

            CreateSectionSheet(
                workbook,
                dashboard,
                sectionName,
                section.Value,
                language);
        }

        using var stream = new MemoryStream();
        workbook.SaveAs(stream);

        return Task.FromResult(stream.ToArray());
    }

    private static void CreateOverviewSheet(
        XLWorkbook workbook,
        FinancialAnalysisDashboardDto dashboard,
        string language)
    {
        var ws =
            workbook.Worksheets.Add(
                language == "ar"
                    ? "الملخص التنفيذي"
                    : "Executive Summary");

        PrepareSheet(ws,language);

        ws.Range("A1:H2").Merge();
        ws.Cell("A1").Value =
            T(LocalizationKeys.FinancialAnalysis.Dashboard,language);

        StyleMainTitle(ws.Range("A1:H2"));

        ws.Range("A4:B4").Merge();
        ws.Range("C4:D4").Merge();
        ws.Range("E4:F4").Merge();
        ws.Range("G4:H4").Merge();

        ws.Cell("A4").Value =
            T(LocalizationKeys.FinancialAnalysis.PeriodFrom,language);

        ws.Cell("C4").Value =
            T(LocalizationKeys.FinancialAnalysis.PeriodTo,language);

        ws.Cell("E4").Value =
            T(LocalizationKeys.FinancialAnalysis.Status,language);

        ws.Cell("G4").Value =
            T(LocalizationKeys.FinancialAnalysis.Scope,language);

        StyleMetaHeader(ws.Range("A4:H4"));

        ws.Range("A5:B5").Merge();
        ws.Range("C5:D5").Merge();
        ws.Range("E5:F5").Merge();
        ws.Range("G5:H5").Merge();

        ws.Cell("A5").Value =
            dashboard.StartDate.ToString("dd/MM/yyyy");

        ws.Cell("C5").Value =
            dashboard.EndDate.ToString("dd/MM/yyyy");

        ws.Cell("E5").Value =
            FinancialAnalysisLocalization.PeriodStatus(
                dashboard.Status,
                language);

        ws.Cell("G5").Value =
            dashboard.IsAllBranches
                ? T(LocalizationKeys.FinancialAnalysis.AllBranches,language)
                : $"{dashboard.SelectedBranch?.BranchCode} - {dashboard.SelectedBranch?.BranchName}";

        StyleMetaValue(ws.Range("A5:H5"));

        WriteKpiCard(
            ws,
            7,
            1,
            T(LocalizationKeys.FinancialAnalysis.ActiveBranches,language),
            dashboard.ActiveBranches.ToString("N0"));

        WriteKpiCard(
            ws,
            7,
            3,
            T(LocalizationKeys.FinancialAnalysis.ExpectedFiles,language),
            dashboard.ExpectedFiles.ToString("N0"));

        WriteKpiCard(
            ws,
            7,
            5,
            T(LocalizationKeys.FinancialAnalysis.ValidFiles,language),
            dashboard.ValidFiles.ToString("N0"));

        WriteKpiCard(
            ws,
            7,
            7,
            T(LocalizationKeys.FinancialAnalysis.CompletionPercentage,language),
            $"{dashboard.CompletionPercentage:N2}%");

        WriteKpiCard(
            ws,
            10,
            1,
            T(LocalizationKeys.FinancialAnalysis.MissingFiles,language),
            dashboard.MissingFiles.ToString("N0"));

        var sectionCount =
            dashboard.SelectedSections.Count;

        WriteKpiCard(
            ws,
            10,
            3,
            T(LocalizationKeys.FinancialAnalysis.IncludedSections,language),
            sectionCount.ToString("N0"));

        WriteKpiCard(
            ws,
            10,
            5,
            T(LocalizationKeys.FinancialAnalysis.FinancialPeriod,language),
            dashboard.FinancialPeriodId.ToString());

        WriteKpiCard(
            ws,
            10,
            7,
            T(LocalizationKeys.FinancialAnalysis.GeneratedAt,language),
            BaghdadNow().ToString("dd/MM/yyyy HH:mm"));

        ws.Range("A14:H14").Merge();
        ws.Cell("A14").Value =
            T(LocalizationKeys.FinancialAnalysis.IncludedSections,language);

        StyleSectionHeader(ws.Range("A14:H14"));

        var row = 15;

        foreach(var section in dashboard.SelectedSections)
        {
            ws.Range(row,1,row,8).Merge();

            ws.Cell(row,1).Value =
                SectionTitle(section,language);

            ws.Cell(row,1)
                .Style.Alignment.Horizontal =
                    language == "ar"
                        ? XLAlignmentHorizontalValues.Right
                        : XLAlignmentHorizontalValues.Left;

            ws.Cell(row,1).Style.Font.Bold = true;

            row++;
        }

        ws.Columns("A:H").Width = 18;
        ws.Column("A").Width = 22;
        ws.Column("C").Width = 22;
        ws.Column("E").Width = 22;
        ws.Column("G").Width = 22;
    }

    private static void CreateSectionSheet(
        XLWorkbook workbook,
        FinancialAnalysisDashboardDto dashboard,
        string sectionName,
        JsonElement section,
        string language)
    {
        var ws =
            workbook.Worksheets.Add(
                SafeSheetName(
                    SectionTitle(sectionName,language)));

        PrepareSheet(ws,language);

        ws.Range("A1:H2").Merge();

        ws.Cell("A1").Value =
            SectionTitle(sectionName,language);

        StyleMainTitle(ws.Range("A1:H2"));

        ws.Range("A4:D4").Merge();
        ws.Range("E4:H4").Merge();

        ws.Cell("A4").Value =
            T(LocalizationKeys.FinancialAnalysis.FinancialPeriod,language);

        ws.Cell("E4").Value =
            T(LocalizationKeys.FinancialAnalysis.Scope,language);

        StyleMetaHeader(ws.Range("A4:H4"));

        ws.Range("A5:D5").Merge();
        ws.Range("E5:H5").Merge();

        ws.Cell("A5").Value =
            $"{dashboard.StartDate:dd/MM/yyyy} - {dashboard.EndDate:dd/MM/yyyy}";

        ws.Cell("E5").Value =
            dashboard.IsAllBranches
                ? T(LocalizationKeys.FinancialAnalysis.AllBranches,language)
                : $"{dashboard.SelectedBranch?.BranchCode} - {dashboard.SelectedBranch?.BranchName}";

        StyleMetaValue(ws.Range("A5:H5"));

        ws.Range("A7:H7").Merge();

        ws.Cell("A7").Value =
            T(LocalizationKeys.FinancialAnalysis.SectionSummary,language);

        StyleSectionHeader(ws.Range("A7:H7"));

        var metrics =
            ExtractSummaryMetrics(section);

        var metricRow = 8;
        var metricColumn = 1;

        foreach(var metric in metrics.Take(12))
        {
            WriteKpiCard(
                ws,
                metricRow,
                metricColumn,
                Label(metric.Name,language),
                FormatElement(metric.Value,language));

            metricColumn += 2;

            if(metricColumn > 7)
            {
                metricColumn = 1;
                metricRow += 3;
            }
        }

        var nextRow =
            metricColumn == 1
                ? metricRow
                : metricRow + 3;

        var objectMetrics =
            section.ValueKind == JsonValueKind.Object
                ? section.EnumerateObject()
                    .Where(x =>
                        x.Value.ValueKind == JsonValueKind.Object &&
                        !IgnoredFields.Contains(x.Name))
                    .ToList()
                : new List<JsonProperty>();

        foreach(var metric in objectMetrics)
        {
            nextRow =
                WriteObjectSummary(
                    ws,
                    nextRow,
                    metric.Name,
                    metric.Value,
                    language);
        }

        if(section.ValueKind == JsonValueKind.Object &&
           section.TryGetProperty("branches",out var branches) &&
           branches.ValueKind == JsonValueKind.Array)
        {
            nextRow += 1;

            ws.Range(nextRow,1,nextRow,8).Merge();

            ws.Cell(nextRow,1).Value =
                T(LocalizationKeys.FinancialAnalysis.BranchDetails,language);

            StyleSectionHeader(ws.Range(nextRow,1,nextRow,8));

            nextRow += 1;

            WriteBranchesTable(
                ws,
                ref nextRow,
                branches,
                language);
        }
        else if(!dashboard.IsAllBranches)
        {
            nextRow += 1;

            ws.Range(nextRow,1,nextRow,8).Merge();

            ws.Cell(nextRow,1).Value =
                T(LocalizationKeys.FinancialAnalysis.Details,language);

            StyleSectionHeader(ws.Range(nextRow,1,nextRow,8));

            nextRow++;

            WriteSingleBranchDetails(
                ws,
                ref nextRow,
                section,
                language);
        }

        foreach(var column in ws.ColumnsUsed())
        {
            if(column.Width < 14)
                column.Width = 14;

            if(column.Width > 28)
                column.Width = 28;
        }
    }

    private static List<(string Name,JsonElement Value)>
        ExtractSummaryMetrics(JsonElement section)
    {
        var result =
            new List<(string Name,JsonElement Value)>();

        if(section.ValueKind != JsonValueKind.Object)
            return result;

        foreach(var p in section.EnumerateObject())
        {
            if(IgnoredFields.Contains(p.Name))
                continue;

            if(p.Value.ValueKind == JsonValueKind.Object ||
               p.Value.ValueKind == JsonValueKind.Array ||
               p.Value.ValueKind == JsonValueKind.Null)
            {
                continue;
            }

            if(!FieldKeys.ContainsKey(p.Name))
                continue;

            result.Add((p.Name,p.Value));
        }

        return result;
    }

    private static int WriteObjectSummary(
        IXLWorksheet ws,
        int row,
        string name,
        JsonElement obj,
        string language)
    {
        if(obj.ValueKind != JsonValueKind.Object)
            return row;

        ws.Range(row,1,row,8).Merge();

        ws.Cell(row,1).Value =
            Label(name,language);

        StyleSubHeader(ws.Range(row,1,row,8));

        row++;

        var values =
            obj.EnumerateObject()
                .Where(x =>
                    x.Value.ValueKind != JsonValueKind.Array &&
                    x.Value.ValueKind != JsonValueKind.Object &&
                    !x.Name.Equals("branchId",StringComparison.OrdinalIgnoreCase))
                .ToList();

        foreach(var item in values)
        {
            ws.Cell(row,1).Value =
                Label(item.Name,language);

            ws.Cell(row,1).Style.Font.Bold = true;

            ws.Range(row,2,row,4).Merge();

            SetValue(
                ws.Cell(row,2),
                item.Value,
                language);

            row++;
        }

        return row + 1;
    }

    private static void WriteBranchesTable(
        IXLWorksheet ws,
        ref int row,
        JsonElement branches,
        string language)
    {
        var items =
            branches.EnumerateArray()
                .Where(x => x.ValueKind == JsonValueKind.Object)
                .ToList();

        if(items.Count == 0)
        {
            ws.Cell(row,1).Value =
                T(LocalizationKeys.FinancialAnalysis.NoData,language);

            row++;
            return;
        }

        var columns =
            items
                .SelectMany(x => x.EnumerateObject())
                .Where(x =>
                    x.Value.ValueKind != JsonValueKind.Array &&
                    x.Value.ValueKind != JsonValueKind.Object &&
                    (
                        x.Name.Equals("branchCode",StringComparison.OrdinalIgnoreCase) ||
                        x.Name.Equals("branchName",StringComparison.OrdinalIgnoreCase) ||
                        FieldKeys.ContainsKey(x.Name)
                    ))
                .Select(x => x.Name)
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .Where(x =>
                    !x.Equals("branchId",StringComparison.OrdinalIgnoreCase) &&
                    !x.Equals("status",StringComparison.OrdinalIgnoreCase))
                .OrderBy(x =>
                    x.Equals("branchCode",StringComparison.OrdinalIgnoreCase) ? 0 :
                    x.Equals("branchName",StringComparison.OrdinalIgnoreCase) ? 1 : 2)
                .ToList();

        if(columns.Count == 0)
        {
            ws.Cell(row,1).Value =
                T(LocalizationKeys.FinancialAnalysis.NoData,language);

            row++;
            return;
        }

        var headerRow = row;

        for(var c = 0;c < columns.Count;c++)
        {
            ws.Cell(row,c + 1).Value =
                Label(columns[c],language);
        }

        StyleTableHeader(
            ws.Range(
                row,
                1,
                row,
                columns.Count));

        row++;

        foreach(var item in items)
        {
            for(var c = 0;c < columns.Count;c++)
            {
                if(item.TryGetProperty(columns[c],out var value))
                {
                    SetValue(
                        ws.Cell(row,c + 1),
                        value,
                        language);
                }
            }

            if(row % 2 == 0)
            {
                ws.Range(row,1,row,columns.Count)
                    .Style.Fill.BackgroundColor =
                        XLColor.AliceBlue;
            }

            row++;
        }

        var tableRange =
            ws.Range(
                headerRow,
                1,
                row - 1,
                columns.Count);

        tableRange.Style.Border.OutsideBorder =
            XLBorderStyleValues.Thin;

        tableRange.Style.Border.InsideBorder =
            XLBorderStyleValues.Hair;
    }

    private static void WriteSingleBranchDetails(
        IXLWorksheet ws,
        ref int row,
        JsonElement section,
        string language)
    {
        if(section.ValueKind != JsonValueKind.Object)
            return;

        foreach(var p in section.EnumerateObject())
        {
            if(IgnoredFields.Contains(p.Name))
                continue;

            if(p.Value.ValueKind == JsonValueKind.Object ||
               p.Value.ValueKind == JsonValueKind.Array ||
               p.Value.ValueKind == JsonValueKind.Null)
            {
                continue;
            }

            if(!FieldKeys.ContainsKey(p.Name))
                continue;

            ws.Cell(row,1).Value =
                Label(p.Name,language);

            ws.Cell(row,1).Style.Font.Bold = true;

            ws.Range(row,2,row,4).Merge();

            SetValue(
                ws.Cell(row,2),
                p.Value,
                language);

            row++;
        }
    }

    private static void WriteKpiCard(
        IXLWorksheet ws,
        int row,
        int column,
        string title,
        string value)
    {
        var titleRange =
            ws.Range(
                row,
                column,
                row,
                column + 1);

        var valueRange =
            ws.Range(
                row + 1,
                column,
                row + 1,
                column + 1);

        titleRange.Merge();
        valueRange.Merge();

        titleRange.Value = title;
        valueRange.Value = value;

        titleRange.Style.Font.Bold = true;
        titleRange.Style.Font.FontSize = 10;
        titleRange.Style.Font.FontColor = XLColor.DarkBlue;
        titleRange.Style.Fill.BackgroundColor = XLColor.AliceBlue;
        titleRange.Style.Alignment.Horizontal = XLAlignmentHorizontalValues.Center;
        titleRange.Style.Alignment.Vertical = XLAlignmentVerticalValues.Center;

        valueRange.Style.Font.Bold = true;
        valueRange.Style.Font.FontSize = 13;
        valueRange.Style.Alignment.Horizontal = XLAlignmentHorizontalValues.Center;
        valueRange.Style.Alignment.Vertical = XLAlignmentVerticalValues.Center;

        var card =
            ws.Range(
                row,
                column,
                row + 1,
                column + 1);

        card.Style.Border.OutsideBorder =
            XLBorderStyleValues.Thin;

        card.Style.Border.OutsideBorderColor =
            XLColor.LightGray;

        ws.Row(row).Height = 24;
        ws.Row(row + 1).Height = 30;
    }

    private static void PrepareSheet(
        IXLWorksheet ws,
        string language)
    {
        ws.RightToLeft = language == "ar";

        ws.SheetView.FreezeRows(2);

        ws.Style.Font.FontName = "Arial";
        ws.Style.Font.FontSize = 10;

        ws.Row(1).Height = 28;
        ws.Row(2).Height = 28;
    }

    private static void StyleMainTitle(
        IXLRange range)
    {
        range.Style.Fill.BackgroundColor =
            XLColor.DarkBlue;

        range.Style.Font.FontColor =
            XLColor.White;

        range.Style.Font.Bold = true;
        range.Style.Font.FontSize = 18;

        range.Style.Alignment.Horizontal =
            XLAlignmentHorizontalValues.Center;

        range.Style.Alignment.Vertical =
            XLAlignmentVerticalValues.Center;
    }

    private static void StyleMetaHeader(
        IXLRange range)
    {
        range.Style.Fill.BackgroundColor =
            XLColor.LightBlue;

        range.Style.Font.Bold = true;

        range.Style.Alignment.Horizontal =
            XLAlignmentHorizontalValues.Center;

        range.Style.Border.OutsideBorder =
            XLBorderStyleValues.Thin;

        range.Style.Border.InsideBorder =
            XLBorderStyleValues.Thin;
    }

    private static void StyleMetaValue(
        IXLRange range)
    {
        range.Style.Font.Bold = true;

        range.Style.Alignment.Horizontal =
            XLAlignmentHorizontalValues.Center;

        range.Style.Border.OutsideBorder =
            XLBorderStyleValues.Thin;

        range.Style.Border.InsideBorder =
            XLBorderStyleValues.Thin;
    }

    private static void StyleSectionHeader(
        IXLRange range)
    {
        range.Style.Fill.BackgroundColor =
            XLColor.DarkBlue;

        range.Style.Font.FontColor =
            XLColor.White;

        range.Style.Font.Bold = true;
        range.Style.Font.FontSize = 12;

        range.Style.Alignment.Horizontal =
            XLAlignmentHorizontalValues.Center;
    }

    private static void StyleSubHeader(
        IXLRange range)
    {
        range.Style.Fill.BackgroundColor =
            XLColor.LightBlue;

        range.Style.Font.Bold = true;

        range.Style.Alignment.Horizontal =
            XLAlignmentHorizontalValues.Center;
    }

    private static void StyleTableHeader(
        IXLRange range)
    {
        range.Style.Fill.BackgroundColor =
            XLColor.DarkBlue;

        range.Style.Font.FontColor =
            XLColor.White;

        range.Style.Font.Bold = true;

        range.Style.Alignment.Horizontal =
            XLAlignmentHorizontalValues.Center;

        range.Style.Alignment.Vertical =
            XLAlignmentVerticalValues.Center;

        range.Style.Border.OutsideBorder =
            XLBorderStyleValues.Thin;

        range.Style.Border.InsideBorder =
            XLBorderStyleValues.Thin;
    }

    private static void SetValue(
        IXLCell cell,
        JsonElement value,
        string language)
    {
        switch(value.ValueKind)
        {
            case JsonValueKind.Number:
                if(value.TryGetDecimal(out var d))
                {
                    cell.Value = d;
                    cell.Style.NumberFormat.Format =
                        "#,##0.00;[Red]-#,##0.00";
                }
                break;

            case JsonValueKind.True:
                cell.Value =
                    T(LocalizationKeys.FinancialAnalysis.Yes,language);
                break;

            case JsonValueKind.False:
                cell.Value =
                    T(LocalizationKeys.FinancialAnalysis.No,language);
                break;

            case JsonValueKind.String:
                var text = value.GetString() ?? string.Empty;

                if(DateTime.TryParse(
                    text,
                    CultureInfo.InvariantCulture,
                    DateTimeStyles.None,
                    out var date))
                {
                    cell.Value =
                        date.ToString("dd/MM/yyyy");
                }
                else
                {
                    cell.Value = text;
                }
                break;

            default:
                cell.Value = string.Empty;
                break;
        }
    }

    private static string FormatElement(
        JsonElement value,
        string language)
    {
        return value.ValueKind switch
        {
            JsonValueKind.Number =>
                value.TryGetDecimal(out var d)
                    ? d.ToString("#,##0.00")
                    : value.ToString(),

            JsonValueKind.True =>
                T(LocalizationKeys.FinancialAnalysis.Yes,language),

            JsonValueKind.False =>
                T(LocalizationKeys.FinancialAnalysis.No,language),

            JsonValueKind.String =>
                value.GetString() ?? string.Empty,

            _ =>
                value.ToString()
        };
    }

    private static string Label(
        string name,
        string language)
    {
        if(FieldKeys.TryGetValue(name,out var key))
        {
            return T(key,language);
        }

        if(name.Contains("highest",StringComparison.OrdinalIgnoreCase))
        {
            return T(
                LocalizationKeys.FinancialAnalysis.Highest,
                language);
        }

        if(name.Contains("lowest",StringComparison.OrdinalIgnoreCase))
        {
            return T(
                LocalizationKeys.FinancialAnalysis.Lowest,
                language);
        }

        if(name.Contains("average",StringComparison.OrdinalIgnoreCase))
        {
            return T(
                LocalizationKeys.FinancialAnalysis.Average,
                language);
        }

        if(name.Contains("total",StringComparison.OrdinalIgnoreCase))
        {
            return T(
                LocalizationKeys.FinancialAnalysis.Total,
                language);
        }

        return name;
    }

    private static string SectionTitle(
        string section,
        string language)
    {
        if(SectionKeys.TryGetValue(section,out var key))
        {
            return T(key,language);
        }

        return section;
    }

    private static string T(
        string key,
        string language)
    {
        return FinancialAnalysisLocalization.T(
            key,
            language);
    }

    private static string SafeSheetName(string value)
    {
        foreach(var c in new[]{':','\\','/','?','*','[',']'})
        {
            value = value.Replace(c,'-');
        }

        return value.Length > 31
            ? value[..31]
            : value;
    }

    private static DateTime BaghdadNow()
    {
        try
        {
            var zone =
                TimeZoneInfo.FindSystemTimeZoneById(
                    "Asia/Baghdad");

            return TimeZoneInfo.ConvertTimeFromUtc(
                DateTime.UtcNow,
                zone);
        }
        catch
        {
            try
            {
                var zone =
                    TimeZoneInfo.FindSystemTimeZoneById(
                        "Arabic Standard Time");

                return TimeZoneInfo.ConvertTimeFromUtc(
                    DateTime.UtcNow,
                    zone);
            }
            catch
            {
                return DateTime.UtcNow.AddHours(3);
            }
        }
    }
}

